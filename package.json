{
  "name": "derbynames",
  "type": "module",
  "scripts": {
    "dev": "vinxi dev",
    "build": "vinxi build",
    "start": "vinxi start",
    "test": "node --test --import tsx \"src/**/*.test.ts\"",
    "test:unit": "node --test --import tsx \"src/**/*.test.ts\"",
    "test:e2e": "playwright test",
    "test:ci": "pnpm run typecheck && pnpm run test:unit && pnpm run build && pnpm run test:e2e",
    "typecheck": "tsc --noEmit --pretty false -p tsconfig.quality.json",
    "audit:deps": "pnpm audit --audit-level high",
    "audit:lighthouse": "pnpm run build && lhci autorun --config=./lighthouserc.json",
    "env:from-example": "node scripts/generate-env-from-example.mjs",
    "db:push": "drizzle-kit push",
    "db:backfill-actions": "tsx scripts/backfill-users-actions.ts",
    "db:verify-actions": "tsx scripts/verify-actions-migration.ts",
    "release:code-preflight": "tsx scripts/release-code-preflight.ts",
    "release:db-cutover": "tsx scripts/release-db-cutover.ts",
    "db:studio": "drizzle-kit studio",
    "clubs:import": "node scripts/import-clubs-ben-to.mjs",
    "db:seed-clubs": "tsx scripts/seed-clubs-from-json.ts"
  },
  "dependencies": {
    "@solidjs/meta": "^0.29.4",
    "@solidjs/router": "^0.15.4",
    "@solidjs/start": "^1.2.1",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.44.7",
    "marked": "^18.0.2",
    "mysql2": "^3.16.1",
    "solid-js": "^1.9.10",
    "vinxi": "^0.5.11"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.61.1",
    "@tailwindcss/vite": "^4.1.18",
    "@types/node": "^24.10.9",
    "drizzle-kit": "^0.31.8",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.21.0",
    "typescript": "5.9.2",
    "vite": "6.4.3"
  },
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "overrides": {
      "rollup": ">=4.59.0",
      "minimatch@10": ">=10.2.3",
      "minimatch@9": ">=9.0.7",
      "minimatch@5": ">=5.1.8",
      "esbuild@<=0.24.2": ">=0.25.0",
      "h3": ">=1.15.9",
      "seroval@<1.4.1": ">=1.4.1",
      "seroval@<=1.4.0": ">=1.4.1",
      "tar": ">=7.5.19",
      "tmp": ">=0.2.6",
      "serialize-javascript": ">=7.0.5",
      "node-forge": ">=1.4.0",
      "picomatch": ">=4.0.4",
      "brace-expansion@2": ">=2.0.3",
      "lodash": ">=4.18.0",
      "@isaacs/brace-expansion@<=5.0.0": ">=5.0.1"
    }
  }
}
